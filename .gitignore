# ==============================================================================
# OpenTofu / Terraform .gitignore
# ==============================================================================

# Local cache directories containing downloaded providers and modules
**/.terraform/
**/.tofu/

# Local state files (Never commit these; they contain unencrypted infrastructure secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all secret/variable files (Contain passwords, tokens, API keys)
*.tfvars
*.tfvars.json

# ...But explicitly allow committing generic example variable templates
!example.tfvars
!example.tfvars.json

# Local-only configuration override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated binary plan files (Can contain transient secrets)
*.tfplan

# CLI configuration files
.terraformrc
terraform.rc

# ==============================================================================
# Dependency Lock File (RECOMMENDED TO COMMIT)
# ==============================================================================
# The lock file ensures consistent provider versions across machines and CI/CD pipelines.
# Un-comment the line below ONLY if you intentionally want to avoid tracking versions.
# .terraform.lock.hcl
